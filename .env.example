# Copy to .env and adjust. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# Database used by the API and by `alembic upgrade head`.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/certificates
# Separate database for pytest. Its name must end in "_test" (the suite refuses anything else).
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/certificates_test

# Where generated PDFs are written (relative paths resolve against the working directory).
OUTPUT_DIR=generated
# How many jobs may generate certificates at the same time.
MAX_CONCURRENT_JOBS=2

# Used by docker-compose.yml. Change POSTGRES_PORT (and the URLs above) if 5432 is taken.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=certificates
POSTGRES_PORT=5432
API_PORT=8000
